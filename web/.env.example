# Copy to .env.local (git-ignored) and fill in from Supabase:
# Project Settings -> API Keys. Use the PUBLISHABLE key (starts sb_publishable_),
# never the secret / service role key: everything in a Vite env var whose name
# starts with VITE_ is bundled into the public website.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
